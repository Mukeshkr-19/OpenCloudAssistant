+def _build_career_wave_gate(expected_date):
+    """Return a career-only wave gate closure (HERMES_CRON_SEARCH_WAVES_V1).
+
+    The closure validates the model final answer against the career output
+    contract, counts only surviving candidates, and returns the next
+    required wave ("wave2"/"wave3") while fewer than TARGET valid
+    candidates survive.  Returns ``None`` when finalization may proceed.
+    Any failure degrades to ``None`` (the scheduler fail-closed output
+    contract still applies).
+    """
+    def _gate(text, messages, wave_state):
+        try:
+            from cron.output_contract import validate_contract, _required_next_wave
+            result = validate_contract(
+                "career_job_match_v1", text, messages,
+                expected_date=expected_date,
+            )
+        except Exception:
+            return None
+        if not (
+            result is not None
+            and getattr(result, "valid", False)
+            and getattr(result, "structure", None) is not None
+        ):
+            return None
+        return _required_next_wave(result.structure, wave_state)
+
+    return _gate
+
+
