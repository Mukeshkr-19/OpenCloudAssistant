+# HERMES_OPENCLOUD_GREETING_OUTPUT_CONTRACT_V1 — reject serialized tool JSON on
+# conversational greeting turns; one bounded repair then deterministic fallback.
+_OPENCLOUD_GREETING_TOOL_TEXT_RES = (
+    re.compile(r'(?i)\{\s*"name"\s*:\s*"clarify"'),
+    re.compile(r'(?i)\{\s*"tool"\s*:'),
+    re.compile(r'(?i)\{\s*"function"\s*:'),
+    re.compile(r'(?i)"tool_calls"\s*:'),
+    re.compile(r"(?i)there is no function to call"),
+    re.compile(r'(?i)"choices"\s*:\s*\['),
+)
+_OPENCLOUD_GREETING_CONTEXT_MAX = 6
+
+
+def _opencloud_greeting_output_contract_valid(text: str) -> bool:
+    raw = (text or "").strip()
+    if not raw:
+        return False
+    for pat in _OPENCLOUD_GREETING_TOOL_TEXT_RES:
+        if pat.search(raw):
+            return False
+    if raw.startswith("{") and raw.endswith("}"):
+        try:
+            obj = json.loads(raw)
+        except Exception:
+            pass
+        else:
+            if isinstance(obj, dict) and any(
+                k in obj for k in ("name", "tool", "function", "tool_calls", "arguments")
+            ):
+                return False
+    return True
+
+
+def _opencloud_isolate_greeting_api_messages(api_messages, user_greeting: str):
+    """Request-only minimal context for greeting turns; durable history untouched."""
+
+    def _plain_text(content) -> str:
+        if isinstance(content, str):
+            return content.strip()
+        if isinstance(content, list):
+            bits = []
+            for part in content:
+                if isinstance(part, dict) and part.get("type") == "text":
+                    bits.append(str(part.get("text") or ""))
+            return " ".join(bits).strip()
+        return ""
+
+    out = []
+    for m in api_messages or []:
+        if isinstance(m, dict) and m.get("role") == "system":
+            out.append(dict(m))
+            break
+    greeting = (user_greeting or "").strip()
+    if greeting:
+        out.append({"role": "user", "content": greeting})
+    recent = []
+    for m in reversed(api_messages or []):
+        if not isinstance(m, dict):
+            continue
+        role = m.get("role")
+        if role == "tool":
+            continue
+        if role == "assistant" and m.get("tool_calls"):
+            continue
+        if m.get("_dropped_toolcall_nudge") or m.get("_empty_recovery_synthetic"):
+            continue
+        if m.get("_cron_synthetic") or m.get("_pre_verify_synthetic"):
+            continue
+        text = _plain_text(m.get("content"))
+        if not text:
+            continue
+        if role not in ("user", "assistant"):
+            continue
+        if '"name"' in text and '"clarify"' in text:
+            continue
+        try:
+            obj = json.loads(text)
+            if isinstance(obj, dict) and "name" in obj:
+                continue
+        except Exception:
+            pass
+        recent.append({"role": role, "content": text[:400]})
+        if len(recent) >= _OPENCLOUD_GREETING_CONTEXT_MAX:
+            break
+    for m in reversed(recent):
+        if m.get("role") == "user" and m.get("content", "").strip() == greeting:
+            continue
+        out.append(m)
+    return out
+
+
+def _opencloud_greeting_conversational_fallback(user_text: str) -> str:
+    raw = (user_text or "").strip()
+    m = re.search(
+        r"(?i)\b(bro|man|dude|buddy|pal|mate|fam|friend|there|hermes|assistant)\b",
+        raw,
+    )
+    if m and m.group(1).lower() in {
+        "bro", "man", "dude", "buddy", "pal", "mate", "fam", "friend",
+    }:
+        return f"Hey {m.group(1).capitalize()}! What's up?"
+    if re.search(r"(?i)good\s*(morning|afternoon|evening)", raw):
+        return "Hey! Good to hear from you — what can I help with?"
+    return "Hey! What's up?"
 
 
+def _opencloud_write_self_heal_inbox_event(payload: dict) -> None:
+    """Drop sanitized events for OpenCloud guarded self-heal auto-ingest."""
+    from pathlib import Path
+
+    state_root = Path(
+        os.environ.get(
+            "OPEN_CLOUD_SELF_HEAL_STATE",
+            str(Path.home() / ".opencloud" / "self-repair"),
+        )
+    ).expanduser()
+    inbox = state_root / "inbox"
+    inbox.mkdir(parents=True, exist_ok=True)
+    path = inbox / f"evt-{int(time.time() * 1000)}-{os.getpid()}.json"
+    tmp = path.with_suffix(".tmp")
+    tmp.write_text(json.dumps(payload), encoding="utf-8")
+    tmp.replace(path)
+
+
+def _opencloud_emit_greeting_contract_violation(agent, *, reason: str) -> None:
+    try:
+        _opencloud_write_self_heal_inbox_event(
+            {
+                "type": "OpenCloudUserOutputContractViolation",
+                "exc_type": "OpenCloudUserOutputContractViolation",
+                "message": f"reason={reason}",
+                "module": "agent.conversation_loop",
+                "context": " ".join(
+                    filter(
+                        None,
+                        [
+                            f"provider={getattr(agent, 'provider', '') or '-'}",
+                            f"model={getattr(agent, 'model', '') or '-'}",
+                            f"platform={getattr(agent, 'platform', '') or '-'}",
+                        ],
+                    )
+                ),
+            }
+        )
+    except Exception:
+        logger.warning(
+            "greeting output contract event emit failed",
+            exc_info=True,
+        )
+
+
+def _opencloud_restore_greeting_turn(agent) -> None:
