+def _career_scout_intent(name: Optional[str], prompt: Optional[str]) -> bool:
+    """Deterministically detect a career job-match (job-scouting) request.
+
+    # HERMES_CRON_WORKFLOW_IDENTITY_V1
+    A natural-language request such as "every day find me the best DevOps/SRE
+    internships" describes the SAME workflow as the canonical
+    ``career_job_match_v1`` job. The model invents a fresh name for it
+    ("daily-internship-scout"), so name/schedule matching alone cannot pin it
+    down. This conservative keyword detector lets the create path resolve such
+    requests to the existing career job instead of duplicating it. It only
+    triggers on strong career-scouting phrasing — it never rejects ordinary
+    scheduled tasks that merely mention a job or a cloud technology.
+    """
+    text = f"{name or ''} {prompt or ''}".lower()
+    return any(kw in text for kw in _CAREER_SCOUT_KEYWORDS)
+
+
+def _meaningful_tokens(text: str) -> set:
+    words = re.findall(r"[a-z][a-z0-9-]{2,}", (text or "").lower())
+    return {w for w in words if w not in _PURPOSE_STOPWORDS}
+
+
+def _purpose_overlaps(
+    name: Optional[str], prompt: Optional[str], existing_job: Dict[str, Any]
+) -> bool:
+    """True when a new request and an existing job share meaningful purpose
+    keywords — i.e. the same task, not merely the same clock time."""
+    new_tokens = _meaningful_tokens(f"{name or ''} {prompt or ''}")
+    old_tokens = _meaningful_tokens(
+        f"{existing_job.get('name') or ''} {existing_job.get('prompt') or ''}"
+    )
+    if not new_tokens or not old_tokens:
+        return False
+    return len(new_tokens & old_tokens) >= 2
+
+
+def _find_equivalent_job(
+    schedule: Optional[str], name: Optional[str], prompt: Optional[str]
+) -> Optional[Dict[str, Any]]:
+    """Return the existing active job this create request is equivalent to.
+
+    # HERMES_CRON_WORKFLOW_IDENTITY_V1
+    Resolution order (first match wins):
+      1. Career-workflow identity — a career-scouting request resolves to the
+         existing ``career_job_match_v1`` job, whatever schedule/name the model
+         invented for it.
+      2. Same recurring schedule AND overlapping purpose — a repeated request
+         for the SAME task at the same time; a genuinely different task at the
+         same time is still allowed to create.
+    Returns the job dict to update, or None when creation should proceed.
+    """
+    active = [j for j in list_jobs(include_disabled=True) if j.get("enabled", True)]
+
+    if _career_scout_intent(name, prompt):
+        for job in active:
+            if (job.get("output_schema") or "") == "career_job_match_v1":
+                return job
+
+    if schedule:
+        same = _existing_recurring_job_at_schedule(schedule)
+        if same is not None and _purpose_overlaps(name, prompt, same):
+            return same
+
+    return None
+
