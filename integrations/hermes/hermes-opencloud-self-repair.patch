+                traceback = traceback.tb_next
+
+            maybe_auto_repair(
+                type(exc).__name__,
+                str(exc),
+                user_request=message_text,
+                module=failing_module,
+                metadata=metadata,
+            )
+        except Exception:
+            logger.warning(
+                "opencloud self-repair dispatch failed; continuing with normal "
+                "error path",
+                exc_info=True,
+            )
+
+    async def _replay_pending_opencloud_repair(self) -> None:
+        """Replay the preserved user request exactly once after a repair restart.
+
+        Consumes the pending-replay marker (idempotent: a second call returns
+        nothing), rebuilds the originating channel from the stored source, and
+        routes it through the normal inbound path.  Dropped safely (logged)
+        when the marker is absent or the channel cannot be reconstructed.
+        Never raises.
+        """
+        try:
+            from agent.opencloud_self_repair import RepairOrchestrator
+
+            state_root = os.path.expanduser(
+                os.environ.get(
+                    "OPEN_CLOUD_REPAIR_STATE",
+                    "~/.local/share/opencloud-repair",
+                )
+            )
+            payload = RepairOrchestrator.consume_pending_replay(state_root)
+            if not payload or not payload.get("request"):
+                return
+            request_text = str(payload.get("request") or "").strip()
+            metadata = payload.get("metadata") or {}
+            source_dict = metadata.get("source") if isinstance(metadata, dict) else None
+
+            source = None
+            if isinstance(source_dict, dict):
+                try:
