+    def _opencloud_describe_model_state(self, session_key: str, current_model: str, current_provider: str) -> str:
+        """Distinguish bootstrap vs Fleet pin vs session override vs fallback."""
+        bits = [f"Active: {current_provider}/{current_model}"]
+        try:
+            override = self._session_model_overrides.get(session_key) or {}
+            if override.get("model"):
+                bits.append("source=MANUAL_SESSION")
+            else:
+                bits.append("source=AUTO_OR_BOOTSTRAP")
+        except Exception:
+            pass
+        try:
+            from agent.hermes_fleet_bridge import session_is_pinned, enabled
+            if enabled() and session_is_pinned(session_key, "main"):
+                bits.append("fleet_pin=yes")
+            else:
+                bits.append("fleet_pin=no")
+        except Exception:
+            pass
+        return " | ".join(bits)
