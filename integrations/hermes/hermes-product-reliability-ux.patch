+# HERMES_OPENCLOUD_TOOL_INTENT_V1 — role-suitable tool exposure for short
+# conversational turns. Not an exact-string "Hi" hack: matches short greeting /
+# pleasantry intents and strips side-effect toolsets for that turn only.
+# Gateway caches agents across turns: always restore before filtering again and
+# before returning so later task turns keep their tools.
+_OPENCLOUD_SIDE_EFFECT_TOOLS = frozenset({
+    "browser_navigate", "browser_snapshot", "browser_click", "browser_type",
+    "browser_scroll", "browser_back", "browser_press", "browser_wait",
+    "browser_vision", "browser_cdp", "browser_dialog",
+    "web_search", "web_extract", "search_web", "search",
+    "clarify", "ask_user", "cronjob", "delegate_task", "execute_code",
+})
+
+
+def _opencloud_is_conversational_greeting(text: str) -> bool:
+    import re
+    raw = (text or "").strip()
+    if not raw or len(raw) > 80:
+        return False
+    if re.search(r"https?://|/\S|\b(search|find|browse|open|run|fix|deploy|cron)\b", raw, re.I):
+        return False
+    if re.fullmatch(
+        r"(?i)(hi|hello|hey|yo|sup|howdy|hiya|good\s*(morning|afternoon|evening))"
+        r"([,.!]+\s*[A-Za-z]{0,24})?[.!]?",
+        raw,
+    ):
+        return True
+    if re.fullmatch(r"(?i)(hi|hello|hey)[.!]?\s+(there|hermes|assistant|friend)[.!]?", raw):
+        return True
+    return False
+
+
+def _opencloud_restore_tools(agent) -> None:
+    restore = getattr(agent, "_opencloud_tool_restore", None)
+    if not callable(restore):
+        return
+    try:
+        restore()
+    except Exception:
+        pass
+    try:
+        agent._opencloud_tool_restore = None
+    except Exception:
+        pass
+
+
+def _opencloud_filter_tools_for_intent(agent, user_text: str) -> None:
+    _opencloud_restore_tools(agent)
+    if not _opencloud_is_conversational_greeting(user_text):
+        return
+    tools = getattr(agent, "tools", None) or []
+    if not tools:
+        return
+    prev_tools = tools
+    prev_names = getattr(agent, "valid_tool_names", None)
+    prev_max = getattr(agent, "max_iterations", None)
+    kept = []
+    for td in tools:
+        name = (td.get("function") or {}).get("name") or td.get("name") or ""
+        if name in _OPENCLOUD_SIDE_EFFECT_TOOLS:
+            continue
+        kept.append(td)
+    agent.tools = kept
+    agent.valid_tool_names = {
+        (t.get("function") or {}).get("name")
+        for t in kept
+        if (t.get("function") or {}).get("name")
+    }
+    try:
+        agent.max_iterations = min(int(prev_max or 1), 2)
+    except Exception:
+        agent.max_iterations = 2
+
+    def _restore():
+        agent.tools = prev_tools
+        if prev_names is not None:
+            agent.valid_tool_names = prev_names
+        if prev_max is not None:
+            agent.max_iterations = prev_max
+
+    agent._opencloud_tool_restore = _restore
+
+
