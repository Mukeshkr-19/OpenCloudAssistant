+def _coerce_repeat(value: Optional[Any]) -> Optional[int]:
+    """Coerce a model-supplied ``repeat`` to a non-negative int (None = forever).
+
+    # HERMES_CRON_REPEAT_COERCION_V1
+    The cronjob schema types ``repeat`` as integer, but a model frequently
+    passes a natural-language string ("forever", "daily", "once"). Comparing
+    that string with ``<= 0`` raises ``TypeError`` and surfaces as an opaque
+    tool error ("'<=' not supported between instances of 'str' and 'int'").
+    Normalize at the API boundary so both create and update are robust: a
+    numeric string coerces to int, non-positive values mean forever, and any
+    unrecognized wording also falls back to forever — never silently truncates
+    a recurring schedule.
+    """
+    if value is None:
+        return None
+    if isinstance(value, bool):
+        return None
+    if isinstance(value, int):
+        return None if value <= 0 else value
+    text = str(value).strip()
+    if not text:
+        return None
+    lowered = text.lower()
+    if lowered in {
+        "forever", "unlimited", "infinite", "none", "null", "always",
+        "daily", "weekly", "monthly", "hourly", "recurring", "repeat",
+        "once", "one-shot", "oneshot",
+    }:
+        return None
+    try:
+        n = int(lowered)
+    except ValueError:
+        return None  # unknown wording -> forever (conservative, non-fatal)
+    return None if n <= 0 else n
+
+
