+# Turn-local run-now idempotency guard.
+#
+# HERMES_CRON_RUN_NOW_ONCE_V1
+# A conversational turn may invoke a cron job's run-now action at most once per
+# job. Keyed by (job_id, inbound message id) so the guard is scoped to the
+# current user turn; a second run-now for the SAME job in the SAME turn returns
+# the cached trigger/run result instead of starting another execution. Direct
+# callers (CLI/scripts) have no session message id, so the guard is inert for
+# them and they keep the previous fire-at-will behavior.
+_RUN_NOW_GUARD: Dict[Tuple[str, str], Tuple[float, Dict[str, Any]]] = {}
+_RUN_NOW_GUARD_LOCK = threading.Lock()
+_RUN_NOW_GUARD_TTL_SECONDS = 1800.0  # 30 min: far beyond one turn; bounds memory
+
+
+def _session_message_id() -> str:
+    """Return the inbound message id for the current turn, or empty string."""
+    try:
+        from gateway.session_context import get_session_env
+        return str(get_session_env("HERMES_SESSION_MESSAGE_ID") or "").strip()
+    except Exception:
+        return ""
+
+
+def _run_now_guard_get(job_id: str) -> Optional[Dict[str, Any]]:
+    """Return the cached run-now result for (job_id, this turn), evicting stale
+    entries, or None when this turn has not yet triggered the job."""
+    message_id = _session_message_id()
+    if not message_id:
+        return None  # no turn scope -> do not guard
+    key = (job_id, message_id)
+    with _RUN_NOW_GUARD_LOCK:
+        now = time.monotonic()
+        for k in list(_RUN_NOW_GUARD):
+            if now - _RUN_NOW_GUARD[k][0] > _RUN_NOW_GUARD_TTL_SECONDS:
+                del _RUN_NOW_GUARD[k]
+        entry = _RUN_NOW_GUARD.get(key)
+        return entry[1] if entry is not None else None
+
+
+def _run_now_guard_put(job_id: str, result: Dict[str, Any]) -> None:
+    message_id = _session_message_id()
+    if not message_id:
+        return
+    with _RUN_NOW_GUARD_LOCK:
+        _RUN_NOW_GUARD[(job_id, message_id)] = (time.monotonic(), result)
+
+
