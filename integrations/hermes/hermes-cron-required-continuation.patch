+    cron_required_tool_continuations = 0
     length_continue_retries = 0
     truncated_tool_call_retries = 0
     truncated_response_parts: List[str] = []
@@ -6932,5 +6935,68 @@ def run_conversation(
                 final_msg = agent._build_assistant_message(assistant_message, finish_reason)

+                # HERMES_CRON_REQUIRED_EXECUTION_CONTINUATION_V1
+                # A cron scheduler may attach a gate that reports mandatory
+                # operations still missing from the live transcript. Refuse a
+                # premature text finalization and give the same tool loop two
+                # bounded chances to execute them. If the model still refuses,
+                # scheduler-side post-run validation remains fail-closed.
+                _cron_gate = getattr(
+                    agent,
+                    "_cron_required_execution_gate",
+                    None,
+                )
+                _cron_missing = ()
+                if callable(_cron_gate):
+                    try:
+                        _cron_missing = tuple(
+                            _cron_gate(messages) or ()
+                        )
+                    except Exception as _cron_gate_exc:
+                        logger.warning(
+                            "cron required-execution gate failed: %s",
+                            type(_cron_gate_exc).__name__,
+                        )
+                        _cron_missing = ()
+
+                if (
+                    _cron_missing
+                    and cron_required_tool_continuations < 2
+                ):
+                    cron_required_tool_continuations += 1
+
+                    logger.warning(
+                        "cron finalization blocked; required operation(s) "
+                        "still missing: %s (continuation %d/2)",
+                        ", ".join(_cron_missing),
+                        cron_required_tool_continuations,
+                    )
+
+                    # Reuse Hermes' existing ephemeral recovery flag so neither
+                    # the attempted final answer nor this synthetic nudge is
+                    # written as durable conversation content.
+                    final_msg["_dropped_toolcall_nudge"] = True
+                    messages.append(final_msg)
+
+                    messages.append({
+                        "role": "user",
+                        "content": (
+                            "[System: This scheduled run is NOT complete. "
+                            "Required operations still missing: "
+                            + ", ".join(_cron_missing)
+                            + ". Execute every missing operation now. "
+                            "Do not return a final answer or [SILENT] until "
+                            "all of them have actually executed.]"
+                        ),
+                        "_dropped_toolcall_nudge": True,
+                    })
+
+                    agent._session_messages = messages
+                    final_response = None
+                    continue
+
+                if not _cron_missing:
+                    cron_required_tool_continuations = 0
+
                 # ── Dropped tool-call recovery (copilot/Claude) ────────
                 # Some providers (observed: claude-opus-4.8 / claude-sonnet-4.5
                 # on GitHub Copilot, ~2026-07) return finish_reason="tool_calls"
