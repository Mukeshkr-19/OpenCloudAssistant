+def _existing_recurring_job_at_schedule(schedule: str) -> Optional[Dict[str, Any]]:
+    """Return an active recurring job already scheduled at the same time.
+
+    # HERMES_CRON_DUPLICATE_GUARD_V1
+    Natural-language cron requests frequently collide with an existing job
+    (e.g. "every day at 9:30 AM ..." vs an existing 9:30 AM career report).
+    Creating a second recurring job at the same time silently duplicates the
+    user's intent and — worse — loses the existing job's extra configuration
+    (required_to_execute, output_schema, routing_profile). This helper lets
+    the create path reject the duplicate deterministically and point the model
+    at ``action='update'`` instead.
+
+    Only recurring schedules (cron / interval) are compared; one-shot jobs are
+    unique instants by construction. Returns the first active job whose
+    normalized recurring schedule equals the requested one, else None.
+    """
+    try:
+        parsed = parse_schedule(schedule)
+    except ValueError:
+        return None
+
+    key = None
+    if parsed.get("kind") == "cron":
+        key = ("cron", str(parsed.get("expr") or "").strip())
+    elif parsed.get("kind") == "interval":
+        key = ("interval", parsed.get("minutes"))
+    if key is None:
+        return None
+
+    for job in list_jobs(include_disabled=True):
+        if not job.get("enabled", True):
+            continue
+        sched = job.get("schedule") or {}
+        other = None
+        if sched.get("kind") == "cron":
+            other = ("cron", str(sched.get("expr") or "").strip())
+        elif sched.get("kind") == "interval":
+            other = ("interval", sched.get("minutes"))
+        if other == key:
+            return job
+    return None
+
+
 def cronjob(
     action: str,
     job_id: Optional[str] = None,
