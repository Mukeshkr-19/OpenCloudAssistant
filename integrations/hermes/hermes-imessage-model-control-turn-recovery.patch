+"""Deterministic model-control + channel-capability fast path.
+
+# HERMES_OPENCLOUD_MODEL_CONTROL_FAST_PATH_V1
+
+Handles high-confidence messaging intents *before* the conversational LLM /
+tools run:
+
+  * "what model are you using?" → read-only routing snapshot
+  * "switch to <model> in <provider>" → Fleet-resolved session pin/override
+  * "can I use voice chat on iMessage?" → channel capability metadata
+
+Pure helpers stay importable for reliability tests. Gateway owns session
+override writes, Fleet pin, and ack delivery.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+import time
+from dataclasses import dataclass
+from typing import Any, List, Optional, Sequence, Tuple
+
+# HERMES_OPENCLOUD_MODEL_CONTROL_FAST_PATH_V1
+
+_STATUS_RE = re.compile(
+    r"(?i)^\s*(?:(?:hey|hi|hello|hermes)[,!]?\s+)?"
+    r"(?:what(?:'s|\s+is)?\s+(?:the\s+)?(?:ai\s+)?model|"
+    r"which\s+(?:ai\s+)?model|"
+    r"what\s+model|"
+    r"current\s+model|"
+    r"model\s+status)"
+    r"(?:\s+(?:are\s+(?:you|u)|is\s+this))?"
+    r"(?:\s+(?:using|on|running))?"
+    r"(?:\s+(?:now|currently|right\s+now))?"
+    r"[?.!]?\s*$"
+)
+
+_CATALOG_RE = re.compile(
+    r"(?i)^\s*(?:(?:hey|hi|hello|hermes)[,!]?\s+)?(?:please\s+)?"
+    r"(?:list|show|display|what(?:'s|\s+is))\s+(?:me\s+)?"
+    r"(?:(?:the|my)\s+)?(?:available\s+|current\s+|fleet\s+)?"
+    r"(?:model\s+catalog|models\s+catalog|models?)\s*[?.!]?\s*$"
+)
+
+_PROVIDER_CATALOG_RE = re.compile(
+    r"(?i)^\s*(?:(?:hey|hi|hello|hermes)[,!]?\s+)?(?:please\s+)?"
+    r"(?:list|show|display)\s+(?:me\s+)?(?:all\s+)?(?P<prov>[\w.-]+)\s+models?\s*[?.!]?\s*$"
+)
+
+_STRUCTURED_SWITCH_RES = (
+    re.compile(
+        r"(?i)^\s*(?:(?:hey|hi|hello|hermes)[,!]?\s+)?"
+        r"(?:please\s+)?use\s+provider\s+(?P<prov>[\w./-]+)\s+model\s+(?P<model>.+?)\s*$"
+    ),
+    re.compile(
+        r"(?i)^\s*(?:(?:hey|hi|hello|hermes)[,!]?\s+)?"
+        r"(?:please\s+)?change\s+the\s+model\s+to\s+(?P<model>.+?)\s+using\s+(?P<prov>[\w./-]+)\s*$"
+    ),
+    re.compile(
+        r"(?i)^\s*(?:(?:hey|hi|hello|hermes)[,!]?\s+)?"
+        r"(?:please\s+)?(?:switch|change|use)\s+(?:to\s+)?(?P<model>.+?)\s+and\s+provider\s+(?P<prov>[\w./-]+)\s*$"
+    ),
+    re.compile(
+        r"(?i)^\s*(?:(?:hey|hi|hello|hermes)[,!]?\s+)?"
+        r"(?:please\s+)?(?:switch|change|use)\s+(?:to\s+)?(?P<model>.+?)\s+(?:on|via|with|using|in)\s+(?P<prov>[\w./-]+)\s*$"
+    ),
+)
+
+_SWITCH_RE = re.compile(
+    r"(?i)^\s*(?:(?:hey|hi|hello|hermes)[,!]?\s+)?"
+    r"(?:please\s+)?"
+    r"(?:switch|change|use)\s+(?:to\s+|over\s+to\s+)?"
+    r"(?P<body>.+?)"
+    r"\s*$"
+)
+
+_VOICE_CAP_RE = re.compile(
+    r"(?i)(?:can\s+i|is\s+it\s+possible\s+to|do\s+you\s+support|are\s+you\s+able\s+to)\s+"
+    r"(?:use\s+)?(?:voice\s+chat|voice\s+calls?|live\s+voice|"
+    r"talk\s+(?:to\s+you\s+)?(?:by|via|with)\s+voice|"
+    r"voice\s+(?:through|over|on|via)\s+(?:imessage|i\s*message|photon|this\s+channel))"
+)
+
+_SLASH_RE = re.compile(r"^\s*/")
+
+
+@dataclass(frozen=True)
+class ModelControlIntent:
+    kind: str  # status | catalog | switch | capability
+    model_query: str = ""
+    provider_hint: str = ""
+    capability: str = ""  # voice_chat
+
+
+@dataclass(frozen=True)
+class ResolvedModel:
+    provider: str
+    model: str
+    group: str = ""
+    candidate: Any = None
+
+
+def _normalize_provider_hint(hint: str) -> str:
+    return (hint or "").strip().lower()
+
+
+def _provider_hint_matches(
+    hint: str, provider: str, group: str, aliases: Sequence[str] = ()
+) -> bool:
+    hint = _normalize_provider_hint(hint)
+    if not hint:
+        return True
+    prov = (provider or "").strip().lower()
+    grp = (group or "").strip().lower()
+    # Exact normalized match only — no substring/prefix collision (acme ≠ acme-plus).
+    accepted = {prov, grp}
+    accepted.update(_normalize_provider_hint(alias) for alias in aliases)
+    return hint in accepted
+
+
+def detect_model_control_intent(text: Optional[str]) -> Optional[ModelControlIntent]:
+    """Return a high-confidence model-control intent, or None to fall through."""
+    if not text or not isinstance(text, str):
+        return None
+    raw = text.strip()
+    if not raw or _SLASH_RE.match(raw):
+        return None
+    if len(raw) > 240:
+        return None
+
+    if _VOICE_CAP_RE.search(raw):
+        return ModelControlIntent(kind="capability", capability="voice_chat")
+
+    provider_catalog = _PROVIDER_CATALOG_RE.match(raw)
+    if provider_catalog:
+        return ModelControlIntent(
+            kind="catalog",
+            provider_hint=_normalize_provider_hint(provider_catalog.group("prov")),
+        )
+
+    if _CATALOG_RE.match(raw):
+        return ModelControlIntent(kind="catalog")
+
+    if _STATUS_RE.match(raw):
+        return ModelControlIntent(kind="status")
+
+    for pat in _STRUCTURED_SWITCH_RES:
+        m = pat.match(raw)
+        if not m:
+            continue
+        model = re.sub(r"\s+", " ", (m.group("model") or "").strip(" ,.-"))
+        prov = _normalize_provider_hint(m.group("prov"))
+        if model and len(model) >= 2 and len(model.split()) <= 8:
+            return ModelControlIntent(
+                kind="switch",
+                model_query=model,
+                provider_hint=prov,
+            )
+
+    m = _SWITCH_RE.match(raw)
+    if not m:
+        return None
+    body = (m.group("body") or "").strip().rstrip(".!?")
+    if not body:
+        return None
+    if re.search(
+        r"(?i)\b(topic|subject|mode|gear|tabs?|apps?|windows?|channel)\b",
+        body,
+    ) and not re.search(r"(?i)\bmodel\b", body):
+        return None
+
+    body = re.sub(r"(?i)\b(?:the\s+)?model\b", " ", body)
+    body = re.sub(r"\s+", " ", body).strip(" ,.-")
+    if not body or len(body) < 2:
+        return None
+    if len(body.split()) > 8:
+        return None
+    return ModelControlIntent(kind="switch", model_query=body, provider_hint="")
+
+
+def normalize_model_query(query: str) -> str:
+    q = (query or "").strip().lower()
+    q = q.replace("_", "-")
+    q = re.sub(r"\s+", " ", q)
+    return q
+
+
+def _candidate_fields(candidate: Any) -> Tuple[str, str, str]:
+    try:
+        from agent.hermes_fleet_bridge import _group, _model, _provider
+
+        return (
+            str(_provider(candidate) or "").strip().lower(),
+            str(_model(candidate) or "").strip(),
+            str(_group(candidate) or "").strip().lower(),
+        )
+    except Exception:
+        if isinstance(candidate, dict):
+            return (
+                str(candidate.get("provider") or "").strip().lower(),
+                str(candidate.get("model") or candidate.get("id") or "").strip(),
+                str(candidate.get("providerGroup") or candidate.get("group") or "")
+                .strip()
+                .lower(),
+            )
+        return ("", "", "")
+
+
+def _candidate_provider_aliases(candidate: Any) -> Tuple[str, ...]:
+    if not isinstance(candidate, dict):
+        return ()
+    aliases = candidate.get("providerAliases") or []
+    if not isinstance(aliases, (list, tuple, set)):
+        return ()
+    return tuple(str(alias).strip().lower() for alias in aliases if str(alias).strip())
+
+
+def resolve_model_alias(
+    query: str,
+    *,
+    provider_hint: str = "",
+    candidates: Optional[Sequence[Any]] = None,
+) -> Tuple[Optional[ResolvedModel], List[ResolvedModel]]:
+    """Resolve a friendly model name against Fleet candidates.
+
+    Returns ``(exact_or_unique, ambiguities)``. Ambiguous matches leave the
+    route unchanged — caller should ask one clarification.
+    """
+    q = normalize_model_query(query)
+    if not q:
+        return None, []
+    hint = _normalize_provider_hint(provider_hint)
+
+    pool: List[ResolvedModel] = []
+    for cand in candidates or []:
+        provider, model, group = _candidate_fields(cand)
+        if not model:
+            continue
+        if not _provider_hint_matches(
+            hint, provider, group, _candidate_provider_aliases(cand)
+        ):
+            continue
+        pool.append(
+            ResolvedModel(provider=provider, model=model, group=group, candidate=cand)
+        )
+
+    if not pool:
+        return None, []
+
+    exact = [
+        r
+        for r in pool
+        if r.model.lower() == q
+        or r.model.lower().endswith("/" + q)
+        or r.model.lower().endswith("-" + q)
+    ]
+    if len(exact) == 1:
+        return exact[0], []
+    if len(exact) > 1:
+        return None, exact
+
+    tokens = [t for t in re.split(r"[\s/]+", q) if t]
+    fuzzy: List[ResolvedModel] = []
+    for r in pool:
+        mid = r.model.lower()
+        if all(tok in mid for tok in tokens):
+            fuzzy.append(r)
+    if len(fuzzy) == 1:
+        return fuzzy[0], []
+    if len(fuzzy) > 1:
+        return None, fuzzy
+    return None, []
+
+
+_ACTIVE_STATUS_SOURCES = frozenset({"MANUAL_SESSION", "RUNNING_AGENT"})
+
+
+@dataclass(frozen=True)
+class ModelStatusSnapshot:
+    provider: str
+    model: str
+    source: str
+    fleet_pin: bool
+    routing_mode: str = ""
+    last_requested_switch: str = ""
+
+
+def resolve_model_status_snapshot(
+    *,
+    session_override: Optional[dict] = None,
+    running_provider: str = "",
+    running_model: str = "",
+    pin_info: Optional[dict] = None,
+    last_requested_switch: str = "",
+    configured_provider: str = "",
+    configured_model: str = "",
+) -> ModelStatusSnapshot:
+    """Read-only precedence for model status (no Fleet selection mutation)."""
+    fleet_pin = bool(pin_info and pin_info.get("fleet_pin"))
+    last_req = (last_requested_switch or "").strip()
+
+    override = session_override or {}
+    if override.get("model"):
+        return ModelStatusSnapshot(
+            provider=str(override.get("provider") or ""),
+            model=str(override.get("model") or ""),
+            source="MANUAL_SESSION",
+            fleet_pin=fleet_pin,
+            routing_mode="manual",
+            last_requested_switch=last_req,
+        )
+
+    if running_model:
+        prov = str(running_provider or "")
+        if prov.lower() == "auto":
+            prov = ""
+        return ModelStatusSnapshot(
+            provider=prov,
+            model=running_model,
+            source="RUNNING_AGENT",
+            fleet_pin=fleet_pin,
+            routing_mode="automatic",
+            last_requested_switch=last_req,
+        )
+
+    if pin_info and pin_info.get("error"):
+        return ModelStatusSnapshot(
+            provider="",
+            model="unknown",
+            source="FLEET_ERROR",
+            fleet_pin=False,
+            routing_mode="automatic",
+            last_requested_switch=last_req,
+        )
+
+    if pin_info and pin_info.get("fleet_pin"):
+        if pin_info.get("resolved") and pin_info.get("model"):
+            prov = str(pin_info.get("provider") or "")
+            if prov.lower() == "auto":
+                prov = ""
+            return ModelStatusSnapshot(
+                provider=prov,
+                model=str(pin_info.get("model") or ""),
+                source="FLEET_PIN",
+                fleet_pin=True,
+                routing_mode="pinned",
+                last_requested_switch=last_req,
+            )
+        return ModelStatusSnapshot(
+            provider="",
+            model="unknown",
+            source="FLEET_PIN_UNRESOLVED",
+            fleet_pin=True,
+            routing_mode="pinned",
+            last_requested_switch=last_req,
+        )
+
+    if configured_model:
+        prov = str(configured_provider or "")
+        if prov.lower() == "auto":
+            prov = ""
+        return ModelStatusSnapshot(
+            provider=prov,
+            model=configured_model,
+            source="CONFIGURED_FALLBACK",
+            fleet_pin=fleet_pin,
+            routing_mode="automatic",
+            last_requested_switch=last_req,
+        )
+
+    return ModelStatusSnapshot(
+        provider="",
+        model="unknown",
+        source="UNKNOWN",
+        fleet_pin=fleet_pin,
+        routing_mode="automatic",
+        last_requested_switch=last_req,
+    )
+
+
+def format_model_status(
+    *,
+    provider: str,
+    model: str,
+    source: str,
+    fleet_pin: bool,
+    routing_mode: str = "",
+    last_requested_switch: str = "",
+) -> str:
+    """Human-readable status from read-only routing snapshot."""
+    route = f"{provider}/{model}" if provider else model
+    if source in _ACTIVE_STATUS_SOURCES:
+        headline = (
+            f"Active route: {route}"
+            if model and model != "unknown"
+            else "Active route: unknown"
+        )
+    elif source == "FLEET_PIN":
+        headline = (
+            f"Fleet pinned route: {route}"
+            if model and model != "unknown"
+            else "Fleet pinned route: unknown"
+        )
+    elif source in {"CONFIGURED_FALLBACK", "BOOTSTRAP"}:
+        headline = f"Configured default: {route}"
+    elif source == "FLEET_PIN_UNRESOLVED":
+        headline = (
+            "Fleet pin present but candidate not resolved "
+            "(runtime route unknown)"
+        )
+    elif source == "FLEET_ERROR":
+        headline = "Model status: unknown (Fleet read failed)"
+    elif source == "UNKNOWN":
+        headline = "Model status: unknown"
+    else:
+        headline = f"Model status: {route}" if model else "Model status: unknown"
+    bits = [
+        headline,
+        f"source={source}",
+        f"fleet_pin={'yes' if fleet_pin else 'no'}",
+    ]
+    if routing_mode:
+        bits.append(f"routing={routing_mode}")
+    if last_requested_switch and last_requested_switch != route:
+        bits.append(f"last_requested_switch={last_requested_switch}")
+    return "\n".join(bits)
+
+
+def format_capability_answer(
+    *,
+    platform: str,
+    capability: str,
+) -> str:
+    """Answer capability questions from channel metadata, not tools."""
+    plat = (platform or "").strip().lower()
+    if capability == "voice_chat":
+        if plat in {"imessage", "photon", "bluebubbles"}:
+            return (
+                "No — live voice chat is not supported on iMessage/Photon.\n"
+                "You can send voice notes (audio messages) as attachments; "
+                "Hermes replies with text (and optional TTS audio when configured). "
+                "There is no interactive two-way voice call over this channel."
+            )
+        if plat in {"discord", "telegram"}:
+            return (
+                "This channel can exchange voice notes / audio messages. "
+                "Live interactive voice-call chat depends on platform voice features "
+                "and is not the default Hermes messaging path."
+            )
+        return (
+            "Live voice chat is not available on this messaging channel. "
+            "Use text (or voice notes where the platform supports audio attachments)."
+        )
+    return "That capability is not advertised for this channel."
+
+
+def format_switch_ack(resolved: ResolvedModel, *, previous: str = "") -> str:
+    prev = f" (was {previous})" if previous else ""
+    return (
+        f"✅ Session model set to {resolved.provider}/{resolved.model}{prev}.\n"
+        "Override is session-scoped (cron/Fleet automatic routing unchanged for other sessions)."
+    )
+
+
+def format_switch_ambiguous(matches: Sequence[ResolvedModel]) -> str:
+    lines = [
+        "Several Fleet models match — reply with: switch to <model-id> on <provider>"
+    ]
+    for i, m in enumerate(matches[:8], 1):
+        lines.append(f"  {i}. {m.provider} / {m.model}")
+    return "\n".join(lines)
+
+
+def format_switch_not_found(query: str, provider_hint: str = "") -> str:
+    hint = f" (provider={provider_hint})" if provider_hint else ""
+    return (
+        f"Could not switch to '{query}'{hint}: no unambiguous verified Fleet route.\n"
+        "Route unchanged. Try /model --catalog or /model <id> --provider <provider>."
+    )
+
+
+def list_fleet_main_candidates() -> List[Any]:
+    """Best-effort Fleet main candidates (verified + available)."""
+    try:
+        from agent.hermes_fleet_bridge import _available, _fleet, enabled
+
+        if not enabled():
+            return []
+        fleet = _fleet()
+        try:
+            return list(_available(fleet, "main") or [])
+        finally:
+            fleet.close()
+    except Exception:
