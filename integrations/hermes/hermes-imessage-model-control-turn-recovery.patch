+def read_fleet_catalog_readonly() -> List[dict]:
+    """Return the discovered Fleet catalog without opening Fleet's database."""
+    try:
+        from agent.hermes_fleet_bridge import CONFIG, ROOT
+
+        cfg = json.loads(CONFIG.read_text(encoding="utf-8"))
+        registry_path = ROOT / "registry" / "models.json"
+        registry = (
+            json.loads(registry_path.read_text(encoding="utf-8"))
+            if registry_path.is_file()
+            else {}
+        )
+    except Exception:
+        return []
+
+    try:
+        from fleet_runtime import verification_ttl_ms
+
+        ttl_ms = verification_ttl_ms()
+    except Exception:
+        ttl_ms = 86_400_000
+    now_ms = int(time.time() * 1000)
+    rows = registry.get("models") or []
+    pools = cfg.get("pools") or {}
+    result: List[dict] = []
+    seen = set()
+    for pool_name in (cfg.get("roles") or {}).get("main", []) or []:
+        pool = pools.get(pool_name) or {}
+        pool_type = str(pool.get("type") or "").strip().lower()
+        provider = str(pool.get("provider") or "").strip()
+        group = str(pool.get("providerGroup") or "").strip()
+        if pool_type == "registry":
+            for row in rows:
+                if not isinstance(row, dict):
+                    continue
+                if str(row.get("providerGroup") or "").strip() != group:
+                    continue
+                if str(row.get("provider") or "").strip() != provider:
+                    continue
+                if pool.get("freeOnly") is True and row.get("explicitFree") is not True:
+                    continue
+                model = str(row.get("id") or "").strip()
+                key = (provider, model)
+                if not model or key in seen:
+                    continue
+                seen.add(key)
+                verified_at = row.get("verifiedAtMs") or row.get("lastProbeMs")
+                try:
+                    fresh = bool(
+                        row.get("verification") == "verified"
+                        and verified_at
+                        and now_ms - int(verified_at) < ttl_ms
+                    )
+                except (TypeError, ValueError, OverflowError):
+                    fresh = False
+                ready = bool(
+                    row.get("productionEligible")
+                    and fresh
+                    and not row.get("discoveryStale")
+                    and not row.get("excludedReason")
+                )
+                status = "verified" if ready else str(
+                    row.get("excludedReason")
+                    or ("stale" if row.get("discoveryStale") else "")
+                    or ("verification-expired" if row.get("verification") == "verified" else "")
+                    or row.get("verification")
+                    or "unverified"
+                )
+                result.append(
+                    {
+                        "provider": provider,
+                        "group": group,
+                        "aliases": list(pool.get("discoveryAliases") or []),
+                        "model": model,
+                        "status": status,
+                    }
+                )
+        elif pool_type == "stable-route":
+            model = str(pool.get("route") or "").strip()
+            key = (provider, model)
+            if provider and model and key not in seen:
+                seen.add(key)
+                result.append(
+                    {
+                        "provider": provider,
+                        "group": group,
+                        "aliases": list(pool.get("discoveryAliases") or []),
+                        "model": model,
+                        "status": "managed",
+                    }
+                )
+    return result
+
+
+def format_fleet_catalog(
+    rows: Sequence[dict], *, provider_hint: str = "", max_chars: int = 12000
+) -> str:
+    """Compact provider-grouped catalog suitable for messaging channels."""
+    hint = _normalize_provider_hint(provider_hint)
+    if hint:
+        rows = [
+            row for row in rows
+            if hint in {
+                _normalize_provider_hint(str(row.get("provider") or "")),
+                _normalize_provider_hint(str(row.get("group") or "")),
+                *(
+                    _normalize_provider_hint(str(alias))
+                    for alias in (row.get("aliases") or [])
+                ),
+            }
+        ]
+    if not rows:
+        return "Fleet model catalog is unavailable. Try /model --catalog --refresh."
+    lines = [
+        "Fleet model catalog snapshot "
+        "(verified routes remain subject to live health checks):"
+    ]
+    current = None
+    shown = 0
+    for row in rows:
+        group = str(row.get("group") or row.get("provider") or "unknown")
+        pending = []
+        if group != current:
+            pending.append(f"\n{group}:")
+        pending.append(f"- {row.get('provider')}/{row.get('model')} [{row.get('status') or 'unknown'}]")
+        if len("\n".join(lines + pending)) > max_chars:
+            break
+        lines.extend(pending)
+        current = group
+        shown += 1
+    if shown < len(rows):
+        lines.append(
+            f"\nShowing {shown} of {len(rows)} models (message-size limit). "
+            "Ask 'show <provider> models' for a provider-only catalog."
+        )
+    lines.append("\nSwitch: change to <model-id> on <provider>. Auto: /model --auto")
+    return "\n".join(lines)
+
+
+def tool_result_is_success(payload: Any) -> bool:
+    """Truthfulness helper: nonzero / error / cancel / unknown ≠ success."""
+    if payload is None:
+        return False
+    data = payload
+    if isinstance(payload, str):
+        text = payload.strip()
+        if not text:
+            return False
+        try:
+            import json
+
+            data = json.loads(text)
+        except Exception:
+            low = text.lower()
+            if "exit_code" in low and re.search(r"exit_code\"?\s*[:=]\s*[1-9]", text):
+                return False
+            if re.search(r"\b(error|failed|cancelled|canceled|timeout)\b", low):
+                return False
+            return "success" in low and "fail" not in low
+    if not isinstance(data, dict):
+        return False
+    if data.get("success") is False or data.get("ok") is False:
+        return False
+    if data.get("error"):
+        return False
+    if str(data.get("status") or "").lower() in {
+        "failed",
+        "error",
+        "cancelled",
+        "canceled",
+        "timeout",
+        "unknown",
+    }:
+        return False
+    try:
+        code = data.get("exit_code", data.get("returncode"))
+        if code is not None and int(code) != 0:
+            return False
+    except Exception:
+        return False
+    if data.get("success") is True or data.get("ok") is True:
+        return True
+    return False
