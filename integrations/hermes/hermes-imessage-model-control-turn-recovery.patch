+def _readonly_fleet_candidate(
+    role,
+    candidate_key,
+):
+    """Resolve a Fleet pin key from fleet.json (+ registry when needed)."""
+
+    if not CONFIG.is_file() or not candidate_key:
+        return None
+
+    try:
+        cfg = json.loads(
+            CONFIG.read_text(
+                encoding="utf-8",
+            )
+        )
+    except Exception:
+        return None
+
+    parts = str(candidate_key).split(":", 2)
+
+    pool_names = (
+        (cfg.get("roles") or {}).get(role)
+        or []
+    )
+    pools = cfg.get("pools") or {}
+    registry = None
+
+    for pool_name in pool_names:
+        pool = pools.get(pool_name) or {}
+        pool_type = str(pool.get("type") or "")
+        group = str(pool.get("providerGroup") or "").strip()
+        if not group:
+            continue
+
+        if pool_type == "stable-route":
+            provider = str(pool.get("provider") or "").strip()
+            model = str(pool.get("route") or "").strip()
+            if not provider or not model:
+                continue
+            key = f"{group}:{provider}:{model}"
+            if key == candidate_key:
+                return {
+                    "providerGroup": group,
+                    "provider": provider,
+                    "model": model,
+                    "candidateKey": key,
+                }
+            continue
+
+        if pool_type != "registry":
+            continue
+
+        if registry is None:
+            registry_path = ROOT / "registry" / "models.json"
+            if not registry_path.is_file():
+                registry = {}
+            else:
+                try:
+                    registry = json.loads(
+                        registry_path.read_text(
+                            encoding="utf-8",
+                        )
+                    )
+                except Exception:
+                    registry = {}
+
+        provider = str(pool.get("provider") or "").strip()
+        if not provider and len(parts) == 3 and parts[0] == group:
+            provider = parts[1]
+        if not provider:
+            continue
+
+        models = (
+            (registry.get("productionModels") or {}).get(group)
+            or []
+        )
+        for model in models:
+            if not isinstance(model, str):
+                continue
+            model = model.strip()
+            if not model:
+                continue
+            key = f"{group}:{provider}:{model}"
+            if key == candidate_key:
+                return {
+                    "providerGroup": group,
+                    "provider": provider,
+                    "model": model,
+                    "candidateKey": key,
+                }
+
+    return None
+
+
+def resolve_session_pin_readonly(
+    session_key,
+    role="main",
+):
+    """Read-only Fleet pin lookup — no dirs, schema migration, or commits."""
+
+    if not session_key or not enabled():
+        return None
+
+    db_path = Path(
+        os.environ.get(
+            "HERMES_FLEET_HEALTH_DB",
+            str(ROOT / "health.sqlite"),
+        )
+    )
+    if not db_path.is_file():
+        return None
+
+    try:
+        if not PIN_KEY.is_file():
+            return {
+                "provider": "",
+                "model": "",
+                "candidate_key": "",
+                "fleet_pin": False,
+                "resolved": False,
+                "error": True,
+            }
+        digest = _session_digest(session_key)
+    except Exception:
+        return {
+            "provider": "",
+            "model": "",
+            "candidate_key": "",
+            "fleet_pin": False,
+            "resolved": False,
+            "error": True,
+        }
+
+    try:
+        import sqlite3
+
+        conn = sqlite3.connect(
+            f"file:{db_path}?mode=ro",
+            uri=True,
+            timeout=5,
+        )
+        try:
+            if not conn.execute(
+                """
+                SELECT 1
+                FROM sqlite_master
+                WHERE type = 'table'
+                  AND name = 'fleet_session_pins'
+                """
+            ).fetchone():
+                return None
+            row = conn.execute(
+                """
+                SELECT candidate_key, routing_profile
+                FROM fleet_session_pins
+                WHERE session_digest = ?
+                  AND role = ?
+                """,
+                (
+                    digest,
+                    role,
+                ),
+            ).fetchone()
+        finally:
+            conn.close()
+    except Exception:
+        return {
+            "provider": "",
+            "model": "",
+            "candidate_key": "",
+            "fleet_pin": False,
+            "resolved": False,
+            "error": True,
+        }
+
+    if not row:
+        return None
+
+    pin = str(row[0] or "") or None
+    pin_profile = str(row[1] or "") if len(row) > 1 else ""
+    if not pin:
+        return None
+
+    candidate = _readonly_fleet_candidate(role, pin)
+    if not candidate:
+        return {
+            "provider": "",
+            "model": "",
+            "candidate_key": pin,
+            "fleet_pin": True,
+            "resolved": False,
+            "routing_profile": pin_profile,
+        }
+
+    return {
+        "provider": _provider(candidate),
+        "model": _model(candidate),
+        "candidate_key": pin,
+        "fleet_pin": True,
+        "resolved": True,
+        "routing_profile": pin_profile,
+    }
 def _configured_default():
 
