+
+    async def _rollback_model_switch(
+        self,
+        session_key: str,
+        *,
+        prev_override,
+        prev_pin_key: str,
+        prev_pin_candidate,
+        prev_pin_profile: str,
+        pin_mutated: bool,
+    ) -> bool:
+        """Verified rollback after a failed model switch.
+
+        Returns True only when the session override AND the Fleet pin (if it
+        was mutated) are confirmed back to their captured prior state.
+        """
+
+        from agent.hermes_fleet_bridge import (
+            _fleet,
+            _set_pin,
+            clear_session_pin,
+            resolve_session_pin_readonly,
+        )
+
+        verified = True
+        # 1) In-memory override: restore the captured prior value (or remove).
+        try:
+            if prev_override:
+                self._session_model_overrides[session_key] = prev_override
+            elif hasattr(self, "_session_model_overrides"):
+                self._session_model_overrides.pop(session_key, None)
+            rb = self._session_model_overrides.get(session_key) or {}
+            if prev_override:
+                verified = verified and (
+                    rb.get("model") == prev_override.get("model")
+                    and (rb.get("provider") or "").lower()
+                    == (prev_override.get("provider") or "").lower()
+                )
+            else:
+                verified = verified and session_key not in self._session_model_overrides
+        except Exception:
+            verified = False
+
+        # 2) Fleet pin: restore the previous pin exactly, or clear when the
+        #    session had none — then verify with a read-back.
+        if verified and pin_mutated:
+            try:
+                if prev_pin_key and prev_pin_candidate:
+                    fleet = _fleet()
+                    try:
+                        _set_pin(
+                            fleet,
+                            "main",
+                            session_key,
+                            prev_pin_candidate,
+                            profile=prev_pin_profile or None,
+                        )
+                    finally:
+                        fleet.close()
+                else:
+                    clear_session_pin(session_key, "main")
+                cur_pin_info = await asyncio.to_thread(
+                    resolve_session_pin_readonly, session_key, "main"
+                )
+                cur_pin_key = str((cur_pin_info or {}).get("candidate_key") or "")
+                if prev_pin_key:
+                    verified = verified and cur_pin_key == prev_pin_key
+                else:
+                    verified = verified and not cur_pin_key
+            except Exception:
+                logger.warning(
+                    "model-control pin rollback failed",
+                    exc_info=True,
+                )
+                verified = False
+        return verified
