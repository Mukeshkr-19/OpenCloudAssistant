+    def _bind_cron_control_session_env(self, source, session_key: str):
+        """Bind session context vars for a cron-control fast-path turn.
+
+        # HERMES_CRON_CONTROL_FAST_PATH_V1
+        Mirrors ``_set_session_env`` but takes the raw ``SessionSource`` — the
+        fast path runs before the full ``SessionContext`` is built. Returns the
+        reset tokens for ``clear_session_vars``, or ``None`` if binding is
+        unavailable (bare test runners built via ``object.__new__``).
+        """
+        try:
+            from gateway.session_context import set_session_vars
+        except Exception:
+            return None
+        _adapters = getattr(self, "adapters", None) or {}
+        _adapter = None
+        try:
+            # Platform is normally a hashable Platform enum; bare test runners
+            # may supply an unhashable stand-in, so guard the dict lookup.
+            _adapter = _adapters.get(getattr(source, "platform", None))
+        except TypeError:
+            _adapter = None
+        _async_delivery = getattr(_adapter, "supports_async_delivery", True)
+        try:
+            return set_session_vars(
+                platform=getattr(source.platform, "value", "") or "",
+                chat_id=getattr(source, "chat_id", "") or "",
+                chat_type=str(getattr(source, "chat_type", "") or ""),
+                chat_name=getattr(source, "chat_name", "") or "",
+                thread_id=str(getattr(source, "thread_id", "") or ""),
+                user_id=str(getattr(source, "user_id", "") or ""),
+                user_name=str(getattr(source, "user_name", "") or ""),
+                session_key=session_key or "",
+                message_id=str(getattr(source, "message_id", "") or ""),
+                profile=getattr(source, "profile", "") or "",
+                async_delivery=_async_delivery,
+                cron_session="",
+            )
+        except Exception:
+            return None
+
+    async def _maybe_handle_cron_control_fast_path(
+        self, event, source, session_key: str
+    ) -> Optional[str]:
+        """Handle a high-confidence cron-control message deterministically.
+
+        # HERMES_CRON_CONTROL_FAST_PATH_V1
+        Runs BEFORE transcript load, context compression, and the
+        conversational LLM. Returns a concise user-facing acknowledgement for
+        handled control messages, or ``None`` to fall through to the ordinary
+        path. Session contextvars are bound and cleared inside this method
+        (try/finally) so an early return can never leak state.
+        """
+        from gateway.cron_control_fast_path import (
+            FAILURE_MSG,
+            NOT_FOUND_MSG,
+            RUN_ACK,
+            detect_career_control_intent,
+            pause_ack,
+            resolve_career_job,
+            resume_ack,
+            spawn_run_now,
+            status_ack,
+        )
+
+        text = (getattr(event, "text", None) or "").strip()
+        intent = detect_career_control_intent(text)
+        if intent is None:
+            return None
+
+        logger.info(
+            "cron-control fast path: platform=%s chat=%s intent=%s msg=%r",
+            getattr(source.platform, "value", None),
+            getattr(source, "chat_id", None),
+            intent,
+            text[:80],
+        )
+
+        tokens = self._bind_cron_control_session_env(source, session_key)
+        try:
+            try:
+                job = await asyncio.to_thread(resolve_career_job)
+            except Exception as exc:
+                logger.warning("cron-control resolve failed: %s", exc)
+                return FAILURE_MSG
+            if not job:
+                return NOT_FOUND_MSG
+            job_id = job.get("id")
+            if not job_id:
+                return NOT_FOUND_MSG
+
+            if intent == "run":
+                # Fire on a daemon thread with the bound context copied so the
+                # run-now-once guard (P12) sees this turn's message id. Return
+                # the ack immediately; cron owns generation + delivery.
+                import contextvars
+                spawn_run_now(job_id, _context=contextvars.copy_context())
+                return RUN_ACK
+
+            try:
+                from tools.cronjob_tools import cronjob as _cronjob
+                if intent == "pause":
+                    await asyncio.to_thread(
+                        _cronjob, action="pause", job_id=job_id
+                    )
+                    return pause_ack(job)
+                if intent == "resume":
+                    await asyncio.to_thread(
+                        _cronjob, action="resume", job_id=job_id
+                    )
+                    return resume_ack(job)
+                if intent == "status":
+                    return status_ack(job)
+            except Exception as exc:
+                logger.warning("cron-control dispatch failed: %s", exc)
+                return FAILURE_MSG
+            return None
+        finally:
+            if tokens is not None:
+                try:
+                    from gateway.session_context import clear_session_vars
+                    clear_session_vars(tokens)
+                except Exception:
+                    pass
