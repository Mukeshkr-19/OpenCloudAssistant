+# HERMES_P13_DIAGNOSTIC_SUPPRESSION_V1
+# Remaining compression/cooldown diagnostics that _TELEGRAM_NOISY_STATUS_RE
+# does not already cover: "compression in progress", explicit cooldown
+# wording, timeout details, and per-iteration counters. These stay in logs; a
+# normal Photon/iMessage user only ever sees the final result — or, on
+# complete failure, the single sanitized failure message from the
+# final-response sanitizer. Deliberately does NOT match COMPACTION_DONE_STATUS
+# ("✓ Context compaction complete — continuing turn..."), which #69546 keeps
+# deliverable as the normal final result. Never assistant prose: the phrasing
+# is status-envelope specific.
+_GATEWAY_COMPRESSION_DIAGNOSTIC_STATUS_RE = re.compile(
+    r"("
+    r"compression\s+in\s+progress"
+    r"|compression\s+(?:cooldown|cooldown\s+active|backoff)"
+    r"|cooldown\s+active\s+for"
+    r"|in\s+cooldown"
+    r"|compression\s+(?:timed?\s+out|timeout)"
+    r"|iteration\s+\d+\s*(?:of|/)"
+    r")",
+    re.IGNORECASE,
+)
+

