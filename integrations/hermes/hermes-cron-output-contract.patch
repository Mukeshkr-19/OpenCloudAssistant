+def _finalize_cron_output_contract(output_schema, final_response, messages, expected_date):
+    """Fail-closed deterministic finalization for an ``output_schema`` job.
+
+    Returns the deterministic rendered report on success, or the visible
+    zero-match report when the contract is invalid OR any contract machinery
+    raises. The raw model ``final_response`` is never returned.
+    """
+    date = expected_date if isinstance(expected_date, str) else ""
+    try:
+        from cron.output_contract import render_contract, validate_contract
+
+        result = validate_contract(
+            output_schema,
+            final_response,
+            messages,
+            expected_date=expected_date,
+        )
+        valid = bool(
+            result is not None
+            and getattr(result, "valid", False)
+            and getattr(result, "structure", None) is not None
+        )
+        if not valid:
+            errors = (
+                getattr(result, "errors", [])
+                if result is not None
+                else ["contract validator returned no result"]
+            ) or ["unknown contract failure"]
+            logger.error(
+                "cron output contract '%s' invalid: %s",
+                output_schema,
+                "; ".join(str(e) for e in errors),
+            )
+            return _cron_zero_match_report(date)
+
+        rendered = render_contract(output_schema, result.structure)
+        if not (isinstance(rendered, str) and rendered.strip()):
+            raise RuntimeError("contract renderer returned empty output")
+        logger.info(
+            "cron output contract '%s' valid; rendered deterministically",
+            output_schema,
+        )
+        return rendered
+    except Exception as exc:
+        logger.error(
+            "cron output contract '%s' failed closed: %s",
+            output_schema,
+            exc,
+        )
+        return _cron_zero_match_report(date)
+
