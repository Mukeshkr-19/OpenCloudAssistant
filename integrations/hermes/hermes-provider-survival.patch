@@ -119,0 +120,15 @@ def _summarize_cron_failure_for_delivery(job: dict, error: str | None) -> str:
+    _provider_failure = any(marker in lower for marker in (
+        "429", "rate limit", "usage limit", "quota", "credits exhausted",
+        "readtimeout", "timed out", "timeout", "authentication", "unauthorized",
+    )) or bool(re.search(r"\b(401|403|5\d\d)\b", text))
