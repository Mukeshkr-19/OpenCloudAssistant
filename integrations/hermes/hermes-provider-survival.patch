@@ -1706,0 +1707,12 @@ def try_activate_fallback(agent, reason: "FailoverReason | None" = None) -> bool
+    # HERMES_PROVIDER_FAILOVER_DEADLINE_V1
+    try:
+        from agent.hermes_fleet_bridge import MAX_FAILOVER_TIME_SECONDS
+        _fleet_failover_started = getattr(agent, "_hermes_fleet_failover_started_at", None)
+        if _fleet_failover_started is None:
+            agent._hermes_fleet_failover_started_at = time.monotonic()
+        elif time.monotonic() - _fleet_failover_started >= MAX_FAILOVER_TIME_SECONDS:
+            logger.warning("Fleet failover deadline exhausted")
+            return False
+    except Exception:
+        pass
+
