--- a/acp_adapter/events.py
+++ b/acp_adapter/events.py
@@ -270,9 +270,22 @@ def make_message_cb(
 ) -> Callable:
     """Create a callback that streams agent response text to the editor."""
 
-    def _message(text: str) -> None:
+    # HERMES_OPENCLOUD_CLARIFY_HARDENING_V1
+def _message(text: str) -> None:
         if not text:
             return
+
+        # Prevent internal tool-call payloads from leaking into user-facing
+        # messaging channels. Tool calls are emitted separately through ACP
+        # tool updates.
+        stripped = text.strip()
+        if stripped.startswith("{") and (
+            '"name"' in stripped
+            or '"tool_calls"' in stripped
+            or '"function"' in stripped
+        ):
+            return
+
         update = acp.update_agent_message_text(text)
         _send_update(conn, session_id, loop, update)
 
