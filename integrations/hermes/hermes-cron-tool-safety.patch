+# HERMES_CRON_REQUIRED_TOOLS_PROTECT_V1_BEGIN
+# Cron jobs may declare explicitly-required operations that must remain
+# directly model-visible and therefore survive progressive disclosure.
+# The protected set is carried on a ContextVar (not a process global) so
+# parallel cron jobs with different required sets never race, and it is
+# reset as soon as the session's tool surface has been assembled.
+from contextvars import ContextVar as _ContextVar
+
+_CRON_PROTECTED_REQUIRED_TOOLS = _ContextVar(
+    "hermes_cron_protected_required_tools",
+    default=frozenset(),
+)
+
+
+def protect_required_tools(names) -> object:
+    """Temporarily mark ``names`` as protected from tool-search deferral.
+
+    Returns an opaque reset token for :func:`reset_required_tools`.
+    """
+    return _CRON_PROTECTED_REQUIRED_TOOLS.set(
+        frozenset(str(n).strip() for n in (names or []) if str(n).strip())
+    )
+
+
+def reset_required_tools(token: object) -> None:
+    """Reset the protected-tools ContextVar to its prior value."""
+    _CRON_PROTECTED_REQUIRED_TOOLS.reset(token)
+
+
+def required_tool_names() -> frozenset:
+    """Names of explicitly-required tools that must stay directly visible."""
+    return _CRON_PROTECTED_REQUIRED_TOOLS.get()
+# HERMES_CRON_REQUIRED_TOOLS_PROTECT_V1_END
+
