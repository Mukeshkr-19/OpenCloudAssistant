+def _resolve_cron_required_tools(job: dict) -> frozenset:
+    """Explicitly-required operations that must stay directly model-visible.
+
+    These are the ALLOWED ∩ explicitly-required-direct operations for this
+    scheduled workflow. Distinct from ``required_to_execute``: a protected
+    operation is guaranteed to survive progressive disclosure, but is not
+    required to produce execution evidence unless the job also declares it in
+    ``required_to_execute``.
+    """
+    raw = job.get("required_tools") or []
+    if isinstance(raw, str):
+        raw = [raw]
+    return frozenset(str(n).strip() for n in raw if str(n).strip())
+
+
+def _resolve_cron_required_to_execute(job: dict) -> frozenset:
+    """Explicitly-required operations that must actually execute this run.
+
+    Never inferred from the enabled toolset: an enabled MCP server does not
+    imply every one of its tools must run on every tick. Only an explicit
+    named-operation requirement populates this set.
+    """
+    raw = job.get("required_to_execute") or []
+    if isinstance(raw, str):
+        raw = [raw]
+    return frozenset(str(n).strip() for n in raw if str(n).strip())
+
+
+# Recognized *unresolved* internal tool-call protocol that must never reach a
+# delivery channel. Mirrors the structural markers Hermes already strips from
+# visible content (cli._strip_reasoning_tags) plus the NVIDIA-NIM / Qwen style
+# ``<|tool_call|>`` tokens. Deliberately structural, not a prose/JSON censor:
+# ordinary text that merely mentions "tool call" / "tool_call" or arbitrary
+# JSON is never matched.
+_TOOL_PROTOCOL_TOKEN_RE = re.compile(r"<\|/?tool_calls?\|>", re.IGNORECASE)
+_TOOL_PROTOCOL_TAG_RE = re.compile(
+    r"</?(?:tool_call|tool_calls|function_call|function_calls)\b[^>]*>",
+    re.IGNORECASE,
+)
+_TOOL_PROTOCOL_FUNCTION_ATTR_RE = re.compile(
+    r"<function\b[^>]*\bname\s*=[^>]*>",
+    re.IGNORECASE,
+)
+
+
+def _contains_unresolved_tool_protocol(text: str) -> bool:
+    """True when ``text`` carries recognized, unresolved internal tool protocol.
+
+    Final cron text is prose: a real tool invocation is emitted as a structured
+    tool call, not raw markers in the final response. Seeing the markers here
+    means the model leaked unresolved protocol that must not be delivered.
+    """
+    if not isinstance(text, str) or not text.strip():
+        return False
+    return bool(
+        _TOOL_PROTOCOL_TOKEN_RE.search(text)
+        or _TOOL_PROTOCOL_TAG_RE.search(text)
+        or _TOOL_PROTOCOL_FUNCTION_ATTR_RE.search(text)
+    )
+
+
+def _executed_tool_names(messages) -> frozenset:
+    """Tool names actually invoked across a run's messages.
+
+    Accounts for both direct tool calls and the progressive-disclosure
+    ``tool_call`` bridge (whose ``arguments.name`` names the underlying tool).
+    """
+    executed = set()
+    for msg in messages or []:
+        if not isinstance(msg, dict):
+            continue
+        for tc in msg.get("tool_calls") or []:
+            fn = None
+            if isinstance(tc, dict):
+                fn = tc.get("function") or {}
+            else:
+                fn = getattr(tc, "function", None) or {}
+            if not isinstance(fn, dict):
+                continue
+            name = str(fn.get("name") or "").strip()
+            if not name:
+                continue
+            if name == "tool_call":
+                try:
+                    args = fn.get("arguments") or {}
+                    if isinstance(args, str):
+                        args = json.loads(args)
+                    inner = str((args or {}).get("name") or "").strip()
+                    if inner:
+                        executed.add(inner)
+                except Exception:
+                    pass
+            else:
+                executed.add(name)
+    return frozenset(executed)
+
