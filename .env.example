# Open Cloud Assistant example configuration.
# Copy this file to .env and fill only the providers/integrations you choose.
# Never commit the real .env file.

# AI providers
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Optional; keep disabled until separately configured and verified.
GEMINI_API_KEY=

# Optional messaging integration
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# Open Cloud Assistant
OPEN_CLOUD_ASSISTANT_HOME="$HOME/.opencloud"
OPEN_CLOUD_ASSISTANT_LOG_LEVEL="INFO"

# Conversation channels

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Discord
DISCORD_BOT_TOKEN=

# Browser / Hermes API
API_SERVER_ENABLED=false
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
API_SERVER_KEY=

# Apple/iMessage is optional and is configured only when selected.
