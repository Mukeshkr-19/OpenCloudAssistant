# Open Cloud Assistant configuration key reference.
#
# Managed runtime configuration is stored at:
#   ~/.opencloud/config.env
#
# Prefer these commands instead of putting real secrets in the repository:
#   ./bin/opencloud providers configure
#   ./bin/opencloud channels configure
#
# Never commit real provider keys, bot tokens, Photon secrets, or API keys.

# AI providers
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
OPEN_CLOUD_MODEL_VERIFICATION_TTL_SECONDS=86400

# Optional; the public Fleet integration keeps Gemini blocked until it is
# separately configured and independently verified.
GEMINI_API_KEY=

# Optional messaging integration
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# Open Cloud Assistant
OPEN_CLOUD_ASSISTANT_HOME="$HOME/.opencloud"
OPEN_CLOUD_ASSISTANT_LOG_LEVEL="INFO"

# Conversation channels

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Discord
DISCORD_BOT_TOKEN=

# Browser / Hermes API preview
API_SERVER_ENABLED=false
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
API_SERVER_KEY=

# Apple/iMessage is optional and is configured only when selected.
