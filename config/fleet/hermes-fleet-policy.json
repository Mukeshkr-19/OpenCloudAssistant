{
  "version": 1,
  "enabled": true,
  "roles": {
    "main": [
      "nvidia-dynamic",
      "zen-free-dynamic",
      "openrouter-free-dynamic",
      "openrouter-free",
      "gemini-emergency"
    ],
    "worker": [
      "zen-free-dynamic",
      "nvidia-dynamic",
      "openrouter-free-dynamic",
      "openrouter-free",
      "gemini-emergency"
    ],
    "reviewer": [
      "nvidia-dynamic",
      "zen-free-dynamic",
      "openrouter-free-dynamic",
      "openrouter-free",
      "gemini-emergency"
    ]
  },
  "pools": {
    "zen-free-dynamic": {
      "type": "registry",
      "providerGroup": "zen",
      "provider": "opencode-zen",
      "discoveryAliases": [
        "opencode-zen",
        "opencode"
      ],
      "freeOnly": true
    },
    "nvidia-dynamic": {
      "type": "registry",
      "providerGroup": "nvidia",
      "provider": "nvidia",
      "discoveryAliases": [
        "nvidia"
      ],
      "freeOnly": false
    },
    "openrouter-free": {
      "type": "stable-route",
      "providerGroup": "openrouter",
      "provider": "openrouter",
      "route": "openrouter/free"
    },
    "openrouter-free-dynamic": {
      "type": "registry",
      "providerGroup": "openrouter",
      "provider": "openrouter",
      "discoveryAliases": [
        "openrouter"
      ],
      "freeOnly": true
    },
    "gemini-emergency": {
      "type": "registry",
      "providerGroup": "gemini",
      "provider": "gemini",
      "discoveryAliases": [
        "gemini"
      ],
      "freeOnly": false,
      "automaticPenalty": 0.35
    }
  },
  "failurePolicy": {
    "modelUnavailableCooldownSeconds": 21600,
    "quotaCooldownSeconds": 21600,
    "rateLimitCooldownSeconds": 300,
    "serverErrorCooldownSeconds": 60,
    "networkCooldownSeconds": 30,
    "authCooldownSeconds": 21600,
    "accountAccessCooldownSeconds": 86400,
    "providerRateTripCount": 2,
    "providerServerTripCount": 2,
    "providerTripWindowSeconds": 60,
    "workerRouteReuseDelaySeconds": 5
  },
  "routingV1": {
    "enabled": true,
    "defaultProfile": "balanced",
    "roleProfiles": {
      "main": "balanced",
      "worker": "fast",
      "reviewer": "deep"
    },
    "allDiscoveredFallback": true,
    "profiles": {
      "fast": {
        "weights": {
          "capability": 0.5,
          "health": 2.0,
          "freshness": 1.0,
          "latency": 4.0
        }
      },
      "balanced": {
        "weights": {
          "capability": 2.0,
          "health": 2.0,
          "freshness": 2.0,
          "latency": 2.0
        }
      },
      "deep": {
        "weights": {
          "capability": 3.0,
          "health": 3.0,
          "freshness": 3.0,
          "latency": 1.0
        }
      }
    },
    "finalEscape": {
      "providerGroup": "openrouter",
      "provider": "openrouter",
      "model": "openrouter/free"
    }
  },
  "verificationV1": {
    "targetVerifiedPerGroup": 2,
    "maxAttemptsPerGroup": 10
  }
}
