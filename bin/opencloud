#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:$HOME/.bun/bin:$HOME/bin:$PATH"

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMMAND="${1:-help}"

case "$COMMAND" in
    doctor)
        shift || true
        exec "$ROOT/scripts/doctor.sh" "$@"
        ;;
    fleet)
        shift || true
        exec "$ROOT/scripts/fleet-status.sh" "$@"
        ;;
    providers)
        shift || true
        exec "$ROOT/scripts/providers.sh" "$@"
        ;;
    channels)
        shift || true
        exec python3 "$ROOT/scripts/channels.py" "$@"
        ;;
    services)
        shift || true
        exec "$ROOT/scripts/services.sh" "$@"
        ;;
    uninstall)
        shift || true
        exec "$ROOT/scripts/uninstall.sh" "${@:-}"
        ;;

    release)
        shift || true

        case "${1:-check}" in
            check)
                exec "$ROOT/scripts/release-check.sh" --check
                ;;
            *)
                echo "Usage: opencloud release check" >&2
                exit 2
                ;;
        esac
        ;;

    version)
        if git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1; then
            echo "Open Cloud Assistant $(git -C "$ROOT" rev-parse --short HEAD)"
        else
            echo "Open Cloud Assistant"
        fi
        ;;
    help|-h|--help)
        echo "Open Cloud Assistant"
        echo
        echo "Usage:"
        echo "  opencloud doctor"
        echo "  opencloud uninstall"
        echo "  opencloud release check"
        echo "  opencloud providers status"
        echo "  opencloud providers configure"
        echo "  opencloud channels configure"
        echo "  opencloud channels status"
        echo "  opencloud fleet status"
        echo "  opencloud fleet paths"
        echo "  opencloud fleet refresh"
        echo "  opencloud fleet verify"
        echo "  opencloud fleet proof"
        echo "  opencloud fleet select [main|worker|reviewer]"
        echo "  opencloud services status"
        echo "  opencloud services plan"
        echo "  opencloud services install"
        echo "  opencloud version"
        echo "  opencloud help"
        ;;
    *)
        echo "Unknown command: $COMMAND" >&2
        echo "Run: opencloud help" >&2
        exit 2
        ;;
esac
