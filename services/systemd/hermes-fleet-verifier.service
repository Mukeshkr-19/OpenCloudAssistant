[Unit]
Description=Verify Open Cloud Assistant dynamic model compatibility
After=network-online.target hermes-fleet-registry.service
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=15min
UMask=0077
EnvironmentFile=-__OPEN_CLOUD_CONFIG__
Environment=OPEN_CLOUD_FLEET_HOME=__FLEET_HOME__
Environment=PATH=__OPEN_CLOUD_HOME__/.local/bin:__OPEN_CLOUD_HOME__/.bun/bin:__OPEN_CLOUD_HOME__/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=__HERMES_PYTHON__ __FLEET_REGISTRY__/verify.py
