[Unit]
Description=Refresh Open Cloud Assistant dynamic model registry
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
EnvironmentFile=-__OPEN_CLOUD_CONFIG__
Environment=PATH=__OPEN_CLOUD_HOME__/.local/bin:__OPEN_CLOUD_HOME__/.bun/bin:__OPEN_CLOUD_HOME__/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=__HERMES_PYTHON__ __FLEET_REGISTRY__/refresh.py
